# Base de datos PostgreSQL. En produccion se usa Neon (provisionado via la
# integracion de Vercel Marketplace, que inyecta estas mismas variables
# automaticamente). Para desarrollo local, crea tu propia base en
# https://neon.tech (gratis) o usa Postgres local, y pon aqui tu connection
# string. `DATABASE_URL` debe ser la conexion "pooled" (pgbouncer) y
# `DATABASE_URL_UNPOOLED` la conexion directa (la usan las migraciones).
DATABASE_URL="postgresql://usuario:password@host-pooler.region.aws.neon.tech/basededatos?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:password@host.region.aws.neon.tech/basededatos?sslmode=require"

# Puerto del servidor (solo se usa en local; en Vercel es serverless)
PORT=4000

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN="http://localhost:5173"

# JWT
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1d"

# Credenciales del usuario admin que crea el seed
SEED_ADMIN_EMAIL="admin@orbit.com"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_USER_EMAIL="user@orbit.com"
SEED_USER_PASSWORD="User123!"
