# Base de datos. Por defecto SQLite (archivo local, sin instalar nada).
DATABASE_URL="file:./dev.db"
# Para usar PostgreSQL en su lugar (ver nota en prisma/schema.prisma):
# DATABASE_URL="postgresql://usuario:password@localhost:5432/orbit_store"

# Puerto del servidor
PORT=4000

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN="http://localhost:5173"

# JWT
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1d"

# Credenciales del usuario admin que crea el seed
SEED_ADMIN_EMAIL="admin@orbit.com"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_USER_EMAIL="user@orbit.com"
SEED_USER_PASSWORD="User123!"
